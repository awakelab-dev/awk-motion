# ─────────────────────────────────────────────────────────────
# Wilox Motion · configuración (copiar a .env en la raíz del repo)
# ─────────────────────────────────────────────────────────────

# Flag de proveedores: mcp (todo en Higgsfield vía conector) · api (API keys) · mock (local, sin red ni créditos)
GENERATION_MODE=mcp

PORT=3001
WEB_ORIGIN=http://localhost:5173
# Otros dominios de esta instalación, separados por comas (hito 12, ADR-151): se aceptan como origen de las
# peticiones (p. ej. observaciones desde un link de revisión enviado con el dominio anterior). Los links nuevos
# salen siempre con WEB_ORIGIN.
# WEB_ORIGIN_ALIASES=https://motion.wiloxagency.com
STORAGE_DIR=storage

# Marca de la instalación (hito 12, ADR-150): carpeta brands/<BRAND>/ (awakelab, …). Sin la línea, la
# identidad neutra de ADR-008. Si la marca no existe o su brand.json no es válido, la API no arranca.
# BRAND=awakelab

# ── Base de datos (hito 3) · contenedor wilox-db de docker-compose.yml ──
# Solo escucha en 127.0.0.1. Si cambias usuario, contraseña o puerto, cambia también DATABASE_URL.
WILOX_DB_PORT=5434
WILOX_DB_USER=wilox
WILOX_DB_PASSWORD=wilox-local
WILOX_DB_NAME=wilox
DATABASE_URL=postgresql://wilox:wilox-local@localhost:5434/wilox
# Sesión (cookie httpOnly): días sin actividad hasta que caduca; COOKIE_SECURE=true solo detrás de HTTPS
SESSION_DAYS=30
COOKIE_SECURE=false
# Música de fondo (hito 5, ADR-044): track por defecto y referencia de volumen (se mezcla a 0.1).
# El selector de Generar lista todos los tracks de su carpeta (o de MUSIC_DIR); uno nuevo aparece sin tocar código.
MUSIC_PATH=assets/music/Inspiring.mp3
# MUSIC_DIR=assets/music
# Igualar la sonoridad (LUFS) de cada track con la de MUSIC_PATH, con un ajuste máximo de ±MUSIC_MAX_GAIN_DB
MUSIC_NORMALIZE=true
MUSIC_MAX_GAIN_DB=12
# Sonido nativo de los clips (hito 6, ADR-059): cada clip se normaliza a MODEL_SOUND_LUFS (media de los SFX
# sintetizados de antes) con un ajuste máximo de ±MODEL_SOUND_MAX_GAIN_DB, y se mezcla a 0.3 bajo la voz
MODEL_SOUND_LUFS=-18.4
MODEL_SOUND_MAX_GAIN_DB=12
# ── Medios en almacenamiento remoto con caché local (hito 8, ADR-093) ──
# none = solo el disco (como hasta el hito 7) · dir = una carpeta que hace de remoto (pruebas) · s3 = AWS_S3_BUCKET
MEDIA_DRIVER=none
# Prefijo propio: wilox-motion/<MEDIA_ENV>/… (prod en el servidor, dev en el Mac)
# Raíz del prefijo propio en el bucket (hito 12, ADR-151): <MEDIA_ROOT>/<MEDIA_ENV>/. wilox-motion es la de
# Awakelab; con MEDIA_ENV=prod y un remoto, solo la acepta BRAND=awakelab. Otra instalación: su propio MEDIA_ROOT.
MEDIA_ROOT=wilox-motion
MEDIA_ENV=dev
# MEDIA_DIR=/ruta/a/una/carpeta        # solo con MEDIA_DRIVER=dir
# Días sin usar tras los cuales la carpeta de un video sale de la caché local (si todo está subido), y horas para los lotes
MEDIA_CACHE_DAYS=14
MEDIA_BATCH_CACHE_HOURS=24
MEDIA_UPLOAD_CONCURRENCY=4
# Duración de las URLs firmadas para lo que no está en la caché (s)
MEDIA_URL_TTL_SEC=21600
# Liberar la caché local sola (false hasta confirmar la migración con pnpm storage:migrate --verify)
MEDIA_EVICT=false
# S3 (MEDIA_DRIVER=s3): credenciales con AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY o el perfil de ~/.aws
# AWS_REGION=eu-west-3
# AWS_S3_BUCKET=
# Publicaciones (hito 9, ADR-101): lo publicado va a wilox-motion/<MEDIA_ENV>/publico/<token>/ y se sirve desde
# esta dirección pública (CloudFront). Sin ella (o con MEDIA_DRIVER=none), desde la API: /api/publico/<token>/…
# MEDIA_PUBLIC_BASE=https://media.awakelab.world
# Cache-Control de lo publicado (s): lo que tarda en verse un final nuevo o una despublicación
MEDIA_PUBLIC_MAX_AGE_SEC=300
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe

# Superprompts (ambos modos)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high
# Segunda pasada de Opus sobre el storyboard y revisión visual de los fotogramas
STORYBOARD_REVIEW=true
IMAGE_REVIEW=true

# ── Modo MCP · conector Higgsfield (OAuth en el navegador la primera vez) ──
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_TOKEN_FILE=~/.wilox/higgsfield-oauth.json
HIGGSFIELD_DEFAULT_VOICE_ID=97775303-f689-4cac-b904-fe7887d4899e
HIGGSFIELD_DECLINED_PRESET_ID=24bae836-2c4a-48e0-89b6-49fcc0b21612
HIGGSFIELD_IMAGE_RESOLUTION=2k
HIGGSFIELD_IMAGE_QUALITY=high
HIGGSFIELD_IMAGE_VARIANT=sunburst
WHISPER_MODEL=small

# ── Modo API ──
MINIMAX_API_KEY=
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_CONCURRENCY=6
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_v3
# Locución de los videos nuevos (hito 10, ADR-133): whole = toda en un solo pedido (sin cambios de tono entre párrafos); paragraph = un pedido por párrafo.
# VOICE_MODE=whole
# Prueba de voz (hito 10, ADR-129): modelo de la variante «pedidos enlazados».
# ELEVENLABS_V4_MODEL=eleven_v4
# Voz por defecto del selector (opcional; en la UI se elige de la lista). Comparación del hito 4: Victoria (chilena)
ELEVENLABS_DEFAULT_VOICE_ID=
# Historial de ElevenLabs tras cada locución: delete (se borra al terminar) · zero (retención cero, solo Enterprise) · keep
ELEVENLABS_HISTORY=delete
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2.5-sunburst
IMAGE_QUALITY=high
# Máximo de imágenes simultáneas (API y regeneraciones en ambos modos); el resto espera en cola
IMAGE_CONCURRENCY=6

# Duración pedida a MiniMax por clip (s)
CLIP_SECONDS=5

# ── Cola global por recurso (hito 5, ADR-045) ──
# Trabajos simultáneos y límite por minuto de cada recurso, para todos los videos y usuarios. Son topes:
# ante un 429 la cola baja la concurrencia, respeta Retry-After y la recupera sola. `pnpm api:limits`
# muestra las cabeceras de límites de cada cuenta para ajustarlos.
QUEUE_ELEVENLABS_CONCURRENCY=5
# QUEUE_ELEVENLABS_PER_MIN=
QUEUE_ANTHROPIC_CONCURRENCY=4
# QUEUE_ANTHROPIC_PER_MIN=
QUEUE_OPENAI_CONCURRENCY=20
# OpenAI tier 5: 250 imágenes por minuto
QUEUE_OPENAI_PER_MIN=250
# Por defecto, MINIMAX_CONCURRENCY
# QUEUE_MINIMAX_CONCURRENCY=6
# QUEUE_MINIMAX_PER_MIN=
QUEUE_HIGGSFIELD_CONCURRENCY=12
# Post y render con ffmpeg en el Mac
QUEUE_FFMPEG_CONCURRENCY=2
# Reintentos de un trabajo ante 429/5xx/red (espera creciente hasta 5 min) antes de marcar el video con error
QUEUE_MAX_RETRIES=12
# Al apagar la API: segundos de espera a los trabajos en marcha (los clips de MiniMax no esperan: se retoman)
SHUTDOWN_GRACE_SEC=90
# Modo mock: multiplica las esperas simuladas (locución 0,6 s, Opus 0,8 s, imagen 1,5 s, clip 8 s); 0 = sin esperas.
# Fallos forzados con marcas en el texto: [mock:fallar] (la locución falla una vez) y [mock:429] (dos 429 y sigue).
MOCK_SPEED=1

# ── Precios para el costo de cada trabajo (GenerationJob, hito 3; precios reales del hito 4, ADR-037) ──
# Sin precio, el trabajo se anota igual con su uso (tokens, créditos, segundos…) y el costo queda vacío.
# Los créditos de Higgsfield por imagen (según resolución y calidad) y por clip (10) ya van en el código.
# Precios públicos de septiembre de 2026 (revisar si cambian):
PRICE_ANTHROPIC_INPUT_PER_MTOK=4
PRICE_ANTHROPIC_OUTPUT_PER_MTOK=20
PRICE_ANTHROPIC_CACHE_READ_PER_MTOK=0.2
# gpt-image-2.5-sunburst por tokens (texto e imagen de entrada, imagen de salida)
PRICE_OPENAI_TEXT_INPUT_PER_MTOK=5
PRICE_OPENAI_IMAGE_INPUT_PER_MTOK=8
PRICE_OPENAI_IMAGE_OUTPUT_PER_MTOK=30
# MiniMax-H3 2K por segundo facturado (5 s = US$ 0,65)
PRICE_MINIMAX_PER_SECOND_2K=0.13
# Dependen del plan (precio del plan / créditos del plan). Planes de Awakelab en septiembre de 2026:
# ElevenLabs: US$ 250 / 1.800.000 créditos · Higgsfield Ultra: US$ 302,50 / 6.000 créditos
PRICE_ELEVENLABS_CREDIT_USD=0.000138889
PRICE_HIGGSFIELD_CREDIT_USD=0.0504167
# Locución de Higgsfield: por defecto 0,15 créditos por cada 50 caracteres; esto fija un valor por llamada
# PRICE_HIGGSFIELD_TTS_CREDITS=
# Precios fijos opcionales (si están, mandan sobre los de arriba)
# PRICE_OPENAI_IMAGE_USD=
# PRICE_MINIMAX_CLIP_USD=
# PRICE_ELEVENLABS_PER_1K_CHARS=
