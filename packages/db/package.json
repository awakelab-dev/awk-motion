{
  "name": "@wilox/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "postinstall": "prisma generate && tsc -p tsconfig.json",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio",
    "admin": "prisma generate > /dev/null && tsx scripts/create-admin.ts",
    "check": "prisma generate > /dev/null && tsx scripts/check.ts",
    "drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --script",
    "test": "vitest run"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@wilox/shared": "workspace:*",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "7.9.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.2"
  }
}
